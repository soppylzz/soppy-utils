{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "util",
    "schema_version",
    "data"
  ],
  "properties": {
    "util": {
      "const": "welcome"
    },
    "schema_version": {
      "const": 1
    },
    "data": {
      "type": "object",
      "required": [
        "name",
        "device",
        "message",
        "rc"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "device": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "rc": {
          "enum": [
            "none",
            "bash",
            "zsh",
            "both"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
