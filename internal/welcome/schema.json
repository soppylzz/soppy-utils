{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "util",
    "schema_version",
    "data"
  ],
  "x-spu-ui": {
    "title": "Welcome banner",
    "order": [
      "name",
      "device",
      "message",
      "rc",
      "banner_in_tmux"
    ],
    "fields": {
      "name": {
        "title": "Banner name"
      },
      "device": {
        "title": "Device name"
      },
      "message": {
        "title": "Message"
      },
      "rc": {
        "title": "Startup hook",
        "options": {
          "none": "None",
          "bash": "Bash",
          "zsh": "Zsh",
          "both": "Both"
        }
      },
      "banner_in_tmux": {
        "title": "Show the banner inside tmux",
        "help": "Every new pane runs your startup file, so this is off unless you want one in each"
      }
    }
  },
  "properties": {
    "util": {
      "const": "welcome"
    },
    "schema_version": {
      "const": 2
    },
    "data": {
      "type": "object",
      "required": [
        "name",
        "device",
        "message",
        "rc",
        "banner_in_tmux"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "device": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "rc": {
          "enum": [
            "none",
            "bash",
            "zsh",
            "both"
          ]
        },
        "banner_in_tmux": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
