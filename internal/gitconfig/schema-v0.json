{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "util",
    "schema_version",
    "data"
  ],
  "properties": {
    "util": {
      "const": "git"
    },
    "schema_version": {
      "const": 0
    },
    "data": {
      "type": "object",
      "properties": {
        "editor": {
          "type": "string",
          "minLength": 1
        },
        "autocrlf": {
          "enum": [
            "input",
            "true",
            "false"
          ]
        },
        "diff_tool": {
          "type": "string",
          "minLength": 1
        },
        "merge_tool": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
