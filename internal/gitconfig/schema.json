{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "util",
    "schema_version",
    "data"
  ],
  "x-spu-ui": {
    "title": "Global Git defaults",
    "order": [
      "editor",
      "autocrlf",
      "diff_tool",
      "merge_tool",
      "aliases"
    ],
    "fields": {
      "editor": {
        "title": "Git editor command"
      },
      "autocrlf": {
        "title": "core.autocrlf",
        "options": {
          "input": "input",
          "true": "true",
          "false": "false"
        }
      },
      "diff_tool": {
        "title": "Diff tool"
      },
      "merge_tool": {
        "title": "Merge tool"
      },
      "aliases": {
        "title": "Aliases",
        "help": "One entry per alias, as a JSON object"
      }
    }
  },
  "properties": {
    "util": {
      "const": "git"
    },
    "schema_version": {
      "const": 1
    },
    "data": {
      "type": "object",
      "required": [
        "editor",
        "autocrlf",
        "diff_tool",
        "merge_tool",
        "aliases"
      ],
      "properties": {
        "editor": {
          "type": "string",
          "minLength": 1
        },
        "autocrlf": {
          "enum": [
            "input",
            "true",
            "false"
          ]
        },
        "diff_tool": {
          "type": "string",
          "minLength": 1
        },
        "merge_tool": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
