{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "util",
    "schema_version",
    "data"
  ],
  "x-spu-ui": {
    "title": "License defaults",
    "order": [
      "type",
      "author",
      "output"
    ],
    "fields": {
      "type": {
        "title": "Preferred license",
        "options": {
          "mit": "MIT",
          "isc": "ISC"
        }
      },
      "author": {
        "title": "Default author"
      },
      "output": {
        "title": "Default output path"
      }
    }
  },
  "properties": {
    "util": {
      "const": "license"
    },
    "schema_version": {
      "const": 1
    },
    "data": {
      "type": "object",
      "required": [
        "type",
        "author",
        "output"
      ],
      "properties": {
        "type": {
          "enum": [
            "mit",
            "isc"
          ]
        },
        "author": {
          "type": "string"
        },
        "output": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
