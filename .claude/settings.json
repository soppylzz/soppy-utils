{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Bash(bash:*)",
      "Bash(go:*)",
      "Bash(gofmt:*)",
      "Bash(shellcheck:*)",
      "Bash(shfmt:*)",
      "Bash(git:*)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ],
    "ask": [
      "Bash(git commit:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Read(./.env*)",
      "Read(./**/.env*)",
      "Read(./secrets/**)",
      "Edit(./.env*)",
      "Bash(curl * | bash:*)"
    ],
    "defaultMode": "acceptEdits"
  },
  "cleanupPeriodDays": 30
}
